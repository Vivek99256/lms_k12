#--------------------------------------------------------------------------
# Where the backend is
#--------------------------------------------------------------------------
#
# Laravel is the source of truth for conversational AI and for ERP data. This
# app is a client of it: it holds no model of the school, runs no tools, and
# makes no data-aware model calls of its own.
#
# Which of the two is used is decided by hostname at runtime (see
# app/components/utils/api_url.tsx): a local-looking host takes _DEV, anything
# else takes _PROD.
NEXT_PUBLIC_API_BASE_URL_DEV=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL_PROD=https://erp.triz.co.in

# The ERP host used by the non-AI data clients (lib/erp-client.ts).
NEXT_PUBLIC_ERP_BASE_URL=https://erp.triz.co.in

# The host running the Laravel AI backend — the assistant, the MCP server and the
# twelve-stage lifecycle, all served by next_lms_erp.
#
# Leave this unset when that application is the same one NEXT_PUBLIC_API_BASE_URL_*
# points at; it falls back to that, and then to the host recorded at login. Set it when
# the AI backend is deployed separately — it then takes precedence over the login host
# too, because `userData.host_name` says where this user signed in, not where the AI
#
# backend runs, and on a split deployment those are different answers.
# The symptom when it is needed but unset is misleading: the ERP host answers every
# other request and returns its own 404 *page* for /api/ai/*, so the assistant reports
# a transport error rather than "this host does not run that backend".
#
# Applies to the whole AI surface — the chat panel, /ai-reports, and the MCP tool calls
# behind the template engine — so all three move together.
# NEXT_PUBLIC_AI_BASE_URL=https://dev.triz.co.in

# Server-to-server override for the assistant's streaming proxy
# (app/api/ai/ask/stream). Set this only when the browser-facing URL and the
# one this server should call differ — a container name, an internal load
# balancer. Falls back to the base URL above, which is right in most
# deployments. Never read from the request: a client that could name the
# upstream could point this route at any host and have the caller's bearer
# token forwarded there.
# AI_UPSTREAM_BASE_URL=http://laravel:8000

#--------------------------------------------------------------------------
# The one local model key
#--------------------------------------------------------------------------
#
# Field editing is the single deliberate exception to "Laravel owns the model
# calls": it is a stateless text transform over one form field, reads no ERP
# data, invokes no tools and persists nothing. Everything conversational or
# data-aware goes to Laravel and uses Laravel's provider key instead.
#
# GEMINI_API_KEY is accepted as a fallback name for the same value.
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

#--------------------------------------------------------------------------
# Candidate screening
#--------------------------------------------------------------------------
#
# Used only by app/api/screenCandidate. Unrelated to the assistant, and listed
# here so it is not mistaken for part of the AI contract above.
OPENROUTER_API_KEY=
SCREENING_DEEPSEEK_API_KEY=
